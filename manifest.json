{
  "manifest_version": 3,
  "name": "ChatGPT Energy & Token Tracker",
  "version": "1.0.0",
  "description": "Track token usage, energy impact, and session metrics for ChatGPT with Arduino integration",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["overlay.css"],
      "matches": ["https://chatgpt.com/*"]
    }
  ]
}